# Variabel lingkungan untuk test (vitest dan playwright memuatnya jika belum diset). Bukan rahasia asli.
# Di laptop, berkas ini menunjuk PostgreSQL dan MinIO milik proyek ini dari docker-compose.yml (port 55432 dan 59000),
# jadi test tidak pernah menyentuh PostgreSQL proyek lain di port 5432. Database mandalika_test dibuat ulang setiap
# putaran test, dan database pengembangan mandalika tidak tersentuh.
# CI mengganti kedua port ke layanan miliknya (5432 dan 9000) sebelum memuat berkas ini.
DATABASE_URL=postgres://mandalika:mandalika@localhost:55432/mandalika_test
BETTER_AUTH_SECRET=rahasia-khusus-test-bukan-untuk-produksi-0123456789
BETTER_AUTH_URL=http://localhost:3000
# Storage S3 untuk unggahan workbook (MinIO di CI dan lokal).
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=mandalika-test
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
