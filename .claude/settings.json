{
  "extraKnownMarketplaces": {
    "jalankan-tiket": {
      "source": {
        "source": "github",
        "repo": "Mandalika-IT-Devs/jalankan-tiket"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "tiket@jalankan-tiket": true
  },
  "permissions": {
    "allow": [
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh run view:*)",
      "Bash(git push:*)",
      "Bash(pnpm:*)",
      "Bash(docker compose:*)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run rerun *)",
      "Bash(gh auth status *)",
      "Bash(sleep *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh label:*)",
      "Bash(gh api:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(git push --force-with-lease *)",
      "Bash(*disetujui-pemilik*)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth switch *)",
      "Bash(gh auth refresh *)",
      "Bash(gh auth token *)",
      "Bash(gh auth setup-git *)"
    ]
  }
}
